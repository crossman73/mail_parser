# ============================================================
# .gitignore — python-email (court-evidence-system)
# ============================================================

# === Python ===
__pycache__/
*.py[cod]
*.so
*.class
.Python
*.egg-info/
dist/
build/

# === Virtual Environments ===
.venv/
.venv-wsl/
.venv-tools/
venv/
ENV/

# === Environment / Secrets ===
.env
.env.*
.vscode/.env
.vscode/*.bak
.vscode/*.bak-*

# === IDE ===
.idea/
!.vscode/

# === Data / DB ===
data/db/*.db
data/db/*.db.backup*
data/*.db
data/cases/
data/timelines/
data/imports/

# === Logs / PID / Lint artifacts ===
logs/
*.log
*.pid
pylint_run.err
pylint_summary.txt
codacy_cli_pid.txt
codacy_run.log

# === Temp / Uploads ===
temp/
uploads/*.mbox

# === Processed / Email data ===
processed_emails/
email_files/

# === Backups ===
archives/
workspace_backups/
repo_cleanup_backups/
*.backup
*.backup_*

# === Generated HTML / Debug artifacts ===
api_docs_response.html
blueprint_register_error.txt

# === VS Code diagnostics (auto-generated) ===
scripts/vscode_diagnostics*/

# === MCP ===
mcp/

# === Test cache ===
.pytest_cache/
.coverage
htmlcov/

# === Codacy large JAR (use Docker instead) ===
tools/codacy/*.jar

# === Codacy cache (corrupted path prefix) ===
\?/

# === OS ===
.DS_Store
Thumbs.db
