  {
    "id" : "SC2032",
    "level" : "High",
    "category" : "ErrorProne",
    "subCategory" : null,
    "title" : "Avoid Invoking Functions via su or Similar Commands",
    "description" : "Detects functions that cannot be invoked via su, sudo, xargs, chroot, or similar commands.",
    "explanation" : "# This function can't be invoked via su on line 42.\n(or from xargs, sudo, chroot, or other commands)\n\nSee companion warning [[SC2033]].\n\n[Source](https://github.com/koalaman/shellcheck/wiki/SC2032)",
