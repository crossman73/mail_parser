    "id" : "duplicate-background-images",
    "level" : "Warning",
    "category" : "Performance",
    "subCategory" : null,
    "title" : "Prohibit duplicated background images",
    "description" : "This rule prohibits the use of duplicated background images across different CSS selectors to optimize performance.",
    "explanation" : "The main solutions for performance is to use as few bytes as possible. In the example bellow we are loading the same image two\ntimes what makes your page slow since those are images that can have big sizes.\n\nEx:\n\n     .icon-a {\n       background: url(icons.png) 10px 0 no-repeat;\n     }\n\n     .icon-b {\n       background: url(icons.png) 20px 0 no-repeat;\n     }\n\nShould be:\n\n     .icons {\n       background: url(icons.png) no-repeat;\n     }\n\n     .icon-a {\n       background-position: 10px 0;\n     }\n\n     .icon-b {\n       background-position: 20px 0;\n     }\n\n[Source](https://github.com/CSSLint/csslint/wiki/Disallow-duplicate-background-images)\n      ",
    "enabled" : false,
