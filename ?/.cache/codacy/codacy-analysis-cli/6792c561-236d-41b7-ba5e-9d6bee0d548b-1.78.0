  {
    "id" : "apex.lang.security.ncino.dml.dmlnativestatements.dml-native-statements",
    "level" : "High",
    "category" : "Security",
    "subCategory" : "Visibility",
    "title" : "Avoid Native Salesforce DML Statements",
    "description" : "Detects usage of native Salesforce DML operations that execute in system context, bypassing user permissions and sharing rules.",
    "explanation" : "## dml-native-statements\nNative Salesforce DML operations execute in system context, ignoring the current user's permissions, field-level security, organization-wide defaults, position in the role hierarchy, and sharing rules. Be mindful when using native Salesforce DML operations.",
    "enabled" : false,
    "timeToFix" : 15,
    "parameters" : [
    ],
    "languages" : [
      {
        "name" : "Apex"
      }
    ]
  },
  {
    "id" : "apex.lang.security.ncino.encryption.badcrypto.bad-crypto",
    "level" : "Error",
    "category" : "Security",
    "subCategory" : "Cryptography",
    "title" : "Avoid Hard-Coding IVs and Keys in Crypto Calls",
    "description" : "Ensure that initialization vectors (IVs) and encryption keys used in cryptographic operations are randomly generated rather than hard-coded.",
    "explanation" : "## bad-crypto\nThe rule makes sure you are using randomly generated IVs and keys for Crypto calls. Hard-coding these values greatly compromises the security of encrypted data.",
