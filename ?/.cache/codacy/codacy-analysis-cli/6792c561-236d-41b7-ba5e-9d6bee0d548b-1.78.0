  {
    "id" : "go.lang.security.injection.open-redirect.open-redirect",
    "level" : "High",
    "category" : "Security",
    "subCategory" : "HTTP",
    "title" : "Avoid Open Redirect Vulnerabilities",
    "description" : "Detects HTTP redirects constructed from user input which can lead to open redirect vulnerabilities.",
    "explanation" : "## open-redirect\nAn HTTP redirect was found to be crafted from user-input `$REQUEST`. This can lead to open redirect vulnerabilities, potentially allowing attackers to redirect users to malicious web sites. It is recommend where possible to not allow user-input to craft the redirect URL. When user-input is necessary to craft the request, it is recommended to follow OWASP best practices to restrict the URL to domains in an allowlist.",
    "enabled" : true,
    "timeToFix" : 15,
    "parameters" : [
