    "id" : "python.pyramid.security.sqlalchemy-sql-injection.pyramid-sqlalchemy-sql-injection",
    "level" : "Error",
    "category" : "Security",
    "subCategory" : "SQLInjection",
    "title" : "Avoid SQL Injection in Pyramid SQLAlchemy Queries",
    "description" : "Detects unsafe usage of raw SQL in distinct, having, group_by, order_by, and filter clauses in SQLAlchemy that can lead to SQL injection vulnerabilities.",
    "explanation" : "## pyramid-sqlalchemy-sql-injection\nDistinct, Having, Group_by, Order_by, and Filter in SQLAlchemy can cause sql injections if the developer inputs raw SQL into the before-mentioned clauses. This pattern captures relevant cases in which the developer inputs raw SQL into the distinct, having, group_by, order_by or filter clauses and injects user-input into the raw SQL with any function besides \"bindparams\". Use bindParams to securely bind user-input to SQL statements.",
    "enabled" : true,
    "timeToFix" : 15,
    "parameters" : [
