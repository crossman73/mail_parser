  {
    "id" : "java.android.best-practice.network-security-config.nsc-pinning-without-backup",
    "level" : "Warning",
    "category" : "BestPractice",
    "subCategory" : null,
    "title" : "Enforce TLS Public Key Pinning with Backup Key",
    "description" : "Detects when an app uses TLS public key pinning without specifying a backup key in the network security configuration.",
    "explanation" : "## nsc-pinning-without-backup\nYour app uses TLS public key pinning without specifying a backup key. If you are forced to change TLS keys or CAs on short notice, not having a backup pin can lead to connectivity issues until you can push out an update. It is considered best practice to add at least one additional pin as a backup.",
    "enabled" : false,
    "timeToFix" : 10,
    "parameters" : [
    ],
    "languages" : [
      {
        "name" : "Java"
      }
    ]
  },
  {
    "id" : "java.android.best-practice.network-security-config.nsc-pinning-without-expiration",
    "level" : "Warning",
    "category" : "BestPractice",
    "subCategory" : null,
    "title" : "Enforce TLS Public Key Pinning with Expiration Date",
    "description" : "Detects use of TLS public key pinning in Android network security configuration without specifying an expiration date.",
    "explanation" : "## nsc-pinning-without-expiration\nYour app uses TLS public key pinning without specifying an expiration date. If your users do not update the app to receive new pins in time, expired or replaced certificates can lead to connectivity issues until they install an update. It is considered best practice to set an expiration time, after which the system will default to trusting system CAs and disregard the pin.",
    "enabled" : false,
    "timeToFix" : 10,
    "parameters" : [
    ],
    "languages" : [
      {
        "name" : "Java"
      }
    ]
  },
  {
    "id" : "java.android.security.exported_activity.exported_activity",
    "level" : "High",
    "category" : "Security",
    "subCategory" : "Android",
    "title" : "Avoid Exporting Android Activities",
    "description" : "Detects when an Android application exports an activity, allowing any application on the device to launch it.",
    "explanation" : "## exported_activity\nThe application exports an activity. Any application on the device can launch the exported activity which may compromise the integrity of your application or its data.  Ensure that any exported activities do not have privileged access to your application's control plane.",
    "enabled" : true,
    "timeToFix" : 10,
    "parameters" : [
