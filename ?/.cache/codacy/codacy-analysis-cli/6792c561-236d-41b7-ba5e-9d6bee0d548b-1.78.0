  {
    "id" : "dockerfile.security.secret-in-build-arg.secret-in-build-arg",
    "level" : "High",
    "category" : "Security",
    "subCategory" : "InsecureStorage",
    "title" : "Avoid using secrets in Docker build-time arguments",
    "description" : "This rule detects the use of secrets in Docker build-time arguments, which are saved in the image and can be accessed by anyone with the image.",
    "explanation" : "## secret-in-build-arg\nDocker build time arguments are not suited for secrets, because the argument values are saved with the image. Running `docker image history` on the image will show information on how the image was built, including arguments. If these contain plain text secrets, anyone with access to the docker image can access those secrets and exploit them.",
    "enabled" : false,
    "timeToFix" : 10,
    "parameters" : [
    ],
    "languages" : [
      {
        "name" : "Dockerfile"
      }
