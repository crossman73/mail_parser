  {
    "id" : "go.jwt-go.security.jwt-none-alg.jwt-go-none-algorithm",
    "level" : "Error",
    "category" : "Security",
    "subCategory" : "Cryptography",
    "title" : "Avoid Using the 'none' Algorithm in JWT Tokens",
    "description" : "Detects the use of the 'none' algorithm in JWT tokens which bypasses signature verification.",
    "explanation" : "## jwt-go-none-algorithm\nDetected use of the 'none' algorithm in a JWT token. The 'none' algorithm assumes the integrity of the token has already been verified. This would allow a malicious actor to forge a JWT token that will automatically be verified. Do not explicitly use the 'none' algorithm. Instead, use an algorithm such as 'HS256'.",
    "enabled" : true,
    "timeToFix" : 10,
    "parameters" : [
