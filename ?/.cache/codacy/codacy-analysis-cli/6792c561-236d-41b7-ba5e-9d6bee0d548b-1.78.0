    "explanation" : "## non-guardrails-direct-call\nDirect OpenAI SDK call detected. Use Guardrails client (GuardrailsOpenAI/GuardrailsAsyncOpenAI) instead.",
    "enabled" : true,
    "timeToFix" : 10,
    "parameters" : [
