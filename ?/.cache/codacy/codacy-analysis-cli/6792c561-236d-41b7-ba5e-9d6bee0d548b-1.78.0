    "id" : "java.jax-rs.security.insecure-resteasy.default-resteasy-provider-abuse",
    "level" : "Error",
    "category" : "Security",
    "subCategory" : "InsecureModulesLibraries",
    "title" : "Avoid Default Resteasy Provider Abuse",
    "description" : "Detects Restful webservice endpoints without a @Consumes annotation that could be abused via the SerializableProvider by processing malicious serialized Java objects.",
    "explanation" : "## default-resteasy-provider-abuse\nWhen a Restful webservice endpoint isn't configured with a @Consumes annotation, an attacker could abuse the SerializableProvider by sending a HTTP Request with a Content-Type of application/x-java-serialized-object. The body of that request would be processed by the SerializationProvider and could contain a malicious payload, which may lead to arbitrary code execution. Instead, add a @Consumes annotation to the function or class.",
    "enabled" : false,
    "timeToFix" : 10,
    "parameters" : [
    ],
    "languages" : [
      {
        "name" : "Java"
      }
    ]
  },
