  {
    "id" : "java.aws-lambda.security.tainted-sqli.tainted-sqli",
    "level" : "Error",
    "category" : "Security",
    "subCategory" : "SQLInjection",
    "title" : "Detect Tainted SQL Statements from Event Object",
    "description" : "Detects SQL statements that are tainted by the AWS Lambda event object which may lead to SQL injection vulnerabilities.",
    "explanation" : "## tainted-sqli\nDetected SQL statement that is tainted by `$EVENT` object. This could lead to SQL injection if variables in the SQL statement are not properly sanitized. Use parameterized SQL queries or properly sanitize user input instead.",
    "enabled" : true,
    "timeToFix" : 15,
    "parameters" : [
