  {
    "id" : "javascript.sequelize.security.audit.sequelize-weak-tls-version.sequelize-weak-tls-version",
    "level" : "High",
    "category" : "Security",
    "subCategory" : "SSL",
    "title" : "Avoid Using Deprecated TLS Versions in Sequelize Configuration",
    "description" : "This rule ensures that deprecated TLS versions TLS1.0 and TLS1.1 are not used in Sequelize database connection configurations, enforcing the use of TLS1.2 or higher.",
    "explanation" : "## sequelize-weak-tls-version\nTLS1.0 and TLS1.1 are deprecated and should not be used anymore. By default, NodeJS used TLSv1.2. So, TLS min version must not be downgrade to TLS1.0 or TLS1.1. Enforce TLS1.3 is highly recommended This rule checks TLS configuration only for PostgreSQL, MariaDB and MySQL. SQLite is not really concerned by TLS configuration. This rule could be extended for MSSQL, but the dialectOptions is specific for Tedious.",
    "enabled" : false,
