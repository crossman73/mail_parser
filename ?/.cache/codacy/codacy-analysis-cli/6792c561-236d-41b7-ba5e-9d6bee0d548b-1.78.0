  {
    "id" : "apex.lang.security.ncino.dml.apexcsrfconstructor.apex-csrf-constructor",
    "level" : "High",
    "category" : "Security",
    "subCategory" : "CSRF",
    "title" : "Avoid DML Operations in Apex Constructors",
    "description" : "Detects DML operations inside Apex class constructors or initializers which can cause unintended database modifications when a page is accessed.",
    "explanation" : "## apex-csrf-constructor\nHaving DML operations in Apex class constructor or initializers can have unexpected side effects: By just accessing a page, the DML statements would be executed and the database would be modified. Just querying the database is permitted.",
    "enabled" : true,
    "timeToFix" : 10,
    "parameters" : [
    ],
    "languages" : [
      {
        "name" : "Apex"
      }
    ]
  },
