    "level" : "Error",
    "category" : "Security",
    "subCategory" : "HTTP",
    "title" : "Avoid Insecure HTTP Requests",
    "description" : "Detects transmission of sensitive or security-critical data over insecure HTTP channels that can be intercepted by unauthorized actors.",
