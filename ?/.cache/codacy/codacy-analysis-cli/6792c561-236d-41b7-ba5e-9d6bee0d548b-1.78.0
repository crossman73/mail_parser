  {
    "id" : "python.sqlalchemy.security.sqlalchemy-execute-raw-query.sqlalchemy-execute-raw-query",
    "level" : "Error",
    "category" : "Security",
    "subCategory" : "SQLInjection",
    "title" : "Avoid SQL String Concatenation in SQLAlchemy Raw Queries",
    "description" : "This rule detects unsafe concatenation of untrusted input with raw SQL queries in SQLAlchemy that can lead to SQL Injection vulnerabilities.",
    "explanation" : "## sqlalchemy-execute-raw-query\nAvoiding SQL string concatenation: untrusted input concatenated with raw SQL query can result in SQL Injection. In order to execute raw query safely, prepared statement should be used. SQLAlchemy provides TextualSQL to easily used prepared statement with named parameters. For complex SQL composition, use SQL Expression Language or Schema Definition Language. In most cases, SQLAlchemy ORM will be a better option.",
    "enabled" : false,
