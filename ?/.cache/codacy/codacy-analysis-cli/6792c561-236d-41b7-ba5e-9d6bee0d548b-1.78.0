  {
    "id" : "bash.lang.correctness.unquoted-expansion.unquoted-command-substitution-in-command",
    "level" : "High",
    "category" : "ErrorProne",
    "subCategory" : null,
    "title" : "Enforce Quoting of Command Substitution",
    "description" : "Ensures that the result of command substitution $(...) or `...` is quoted to prevent word splitting and unexpected tokenization.",
    "explanation" : "## unquoted-command-substitution-in-command\nThe result of command substitution $(...) or `...`, if unquoted, is split on whitespace or other separators specified by the IFS variable. You should surround it with double quotes to avoid splitting the result.",
    "enabled" : false,
    "timeToFix" : 5,
    "parameters" : [
    ],
    "languages" : [
      {
