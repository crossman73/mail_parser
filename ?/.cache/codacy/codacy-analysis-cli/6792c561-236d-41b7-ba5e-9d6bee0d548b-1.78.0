    "id" : "java.lang.security.audit.xssrequestwrapper-is-insecure.xssrequestwrapper-is-insecure",
    "level" : "Error",
    "category" : "Security",
    "subCategory" : "XSS",
    "title" : "Avoid Using Insecure XSSRequestWrapper Implementation",
    "description" : "Detects usage of an insecure XSSRequestWrapper implementation from dzone that provides ineffective XSS filtering.",
    "explanation" : "## xssrequestwrapper-is-insecure\nIt looks like you're using an implementation of XSSRequestWrapper from dzone. (https://www.javacodegeeks.com/2012/07/anti-cross-site-scripting-xss-filter.html) The XSS filtering in this code is not secure and can be bypassed by malicious actors. It is recommended to use a stack that automatically escapes in your view or templates instead of filtering yourself.",
    "enabled" : false,
    "timeToFix" : 15,
    "parameters" : [
    ],
    "languages" : [
      {
        "name" : "Java"
      }
    ]
  },
  {
    "id" : "java.lang.security.audit.xxe.documentbuilderfactory-disallow-doctype-decl-false.documentbuilderfactory-disallow-doctype-decl-false",
    "level" : "Error",
    "category" : "Security",
    "subCategory" : "InputValidation",
    "title" : "Disallow DOCTYPE Declarations in DocumentBuilderFactory to Prevent XXE",
    "description" : "This rule ensures that DOCTYPE declarations are disabled in the DocumentBuilderFactory to prevent XML External Entity (XXE) attacks.",
    "explanation" : "## documentbuilderfactory-disallow-doctype-decl-false\nDOCTYPE declarations are enabled for $DBFACTORY. Without prohibiting external entity declarations, this is vulnerable to XML external entity attacks. Disable this by setting the feature \"http://apache.org/xml/features/disallow-doctype-decl\" to true. Alternatively, allow DOCTYPE declarations and only prohibit external entities declarations. This can be done by setting the features \"http://xml.org/sax/features/external-general-entities\" and \"http://xml.org/sax/features/external-parameter-entities\" to false.",
    "enabled" : true,
    "timeToFix" : 10,
    "parameters" : [
    ],
    "languages" : [
      {
        "name" : "Java"
      }
    ]
  },
