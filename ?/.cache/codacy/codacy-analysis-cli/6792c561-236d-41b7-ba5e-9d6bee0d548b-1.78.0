    "id" : "terraform.aws.security.insecure-load-balancer-tls-version.insecure-load-balancer-tls-version",
    "level" : "High",
    "category" : "Security",
    "subCategory" : "SSL",
    "title" : "Avoid Insecure TLS Versions on AWS Load Balancers",
    "description" : "Detects AWS load balancers configured with insecure TLS versions less than 1.2.",
    "explanation" : "## insecure-load-balancer-tls-version\nDetected an AWS load balancer with an insecure TLS version. TLS versions less than 1.2 are considered insecure because they can be broken. To fix this, set your `ssl_policy` to `\"ELBSecurityPolicy-TLS13-1-2-2021-06\"`, or include a default action to redirect to HTTPS.",
    "enabled" : true,
    "timeToFix" : 10,
    "parameters" : [
    ],
    "languages" : [
