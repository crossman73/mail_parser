  {
    "id" : "java.spring.security.injection.tainted-system-command.tainted-system-command",
    "level" : "Error",
    "category" : "Security",
    "subCategory" : "CommandInjection",
    "title" : "Avoid Tainted System Command Execution",
    "description" : "Detects when user input is passed directly to methods that execute system commands, potentially leading to command injection vulnerabilities.",
    "explanation" : "## tainted-system-command\nDetected user input entering a method which executes a system command. This could result in a command injection vulnerability, which allows an attacker to inject an arbitrary system command onto the server. The attacker could download malware onto or steal data from the server. Instead, use ProcessBuilder, separating the command into individual arguments, like this: `new ProcessBuilder(\"ls\", \"-al\", targetDirectory)`. Further, make sure you hardcode or allowlist the actual command so that attackers can't run arbitrary commands.",
    "enabled" : true,
    "timeToFix" : 15,
    "parameters" : [
    ],
    "languages" : [
      {
        "name" : "Java"
      }
    ]
  },
  {
    "id" : "java.spring.security.injection.tainted-url-host.tainted-url-host",
    "level" : "Error",
    "category" : "Security",
    "subCategory" : "InputValidation",
    "title" : "Avoid Tainted URL Host in Spring Applications",
    "description" : "Detects when user input is used in the host portion of a manually constructed URL, which can lead to server-side request forgery (SSRF).",
    "explanation" : "## tainted-url-host\nUser data flows into the host portion of this manually-constructed URL. This could allow an attacker to send data to their own server, potentially exposing sensitive data such as cookies or authorization information sent with this request. They could also probe internal servers or other resources that the server running this code can access. (This is called server-side request forgery, or SSRF.) Do not allow arbitrary hosts. Instead, create an allowlist for approved hosts, hardcode the correct host, or ensure that the user data can only affect the path or parameters.",
    "enabled" : true,
    "timeToFix" : 15,
    "parameters" : [
    ],
    "languages" : [
      {
        "name" : "Java"
      }
    ]
