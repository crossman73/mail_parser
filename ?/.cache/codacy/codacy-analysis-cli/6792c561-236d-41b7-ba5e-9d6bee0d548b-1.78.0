    "id" : "terraform.aws.security.aws-subnet-has-public-ip-address.aws-subnet-has-public-ip-address",
    "level" : "High",
    "category" : "Security",
    "subCategory" : "Visibility",
    "title" : "Avoid assigning public IP addresses to AWS subnets",
    "description" : "Detects AWS subnets where resources are assigned public IP addresses, potentially exposing them to the public internet.",
    "explanation" : "## aws-subnet-has-public-ip-address\nResources in the AWS subnet are assigned a public IP address. Resources should not be exposed on the public internet, but should have access limited to consumers required for the function of your application. Set `map_public_ip_on_launch` to false so that resources are not publicly-accessible.",
    "enabled" : true,
