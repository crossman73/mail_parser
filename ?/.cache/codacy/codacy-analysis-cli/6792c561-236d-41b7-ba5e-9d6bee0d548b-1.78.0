    "id" : "elixir.lang.correctness.atom-exhaustion.atom_exhaustion",
    "level" : "Error",
    "category" : "Security",
    "subCategory" : "InsecureModulesLibraries",
    "title" : "Avoid Atom Exhaustion",
    "description" : "Detects usage of dynamic atom creation functions which can lead to memory leaks due to atom table exhaustion.",
    "explanation" : "## atom_exhaustion\nAtom values are appended to a global table but never removed. If input is user-controlled, dynamic instantiations such as `String.to_atom` or `List.to_atom` can lead to possible memory leaks. Instead, use `String.to_existing_atom` or `List.to_existing_atom`.",
    "enabled" : false,
    "timeToFix" : 5,
    "parameters" : [
    ],
    "languages" : [
      {
        "name" : "Elixir"
      }
    ]
  },
