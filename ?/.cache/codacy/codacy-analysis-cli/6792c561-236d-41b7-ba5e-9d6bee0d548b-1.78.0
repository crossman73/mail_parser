    "id" : "java.lang.security.audit.tainted-cmd-from-http-request.tainted-cmd-from-http-request",
    "level" : "Error",
    "category" : "Security",
    "subCategory" : "CommandInjection",
    "title" : "Avoid Command Injection from HTTPServletRequest in ProcessBuilder or exec",
    "description" : "Detects usage of input from HTTPServletRequest passed directly into ProcessBuilder or exec commands, which can lead to command injection vulnerabilities.",
    "explanation" : "## tainted-cmd-from-http-request\nDetected input from a HTTPServletRequest going into a 'ProcessBuilder' or 'exec' command. This could lead to command injection if variables passed into the exec commands are not properly sanitized. Instead, avoid using these OS commands with user-supplied input, or, if you must use these commands, use a whitelist of specific values.",
    "enabled" : true,
    "timeToFix" : 15,
    "parameters" : [
    ],
    "languages" : [
      {
        "name" : "Java"
      }
    ]
  },
