    "level" : "High",
    "category" : "Security",
    "subCategory" : "SSL",
    "title" : "Avoid Using DefaultHttpClient with Default Constructor",
    "description" : "Detects usage of DefaultHttpClient instantiated with its default constructor, which is not compatible with TLS 1.2.",
