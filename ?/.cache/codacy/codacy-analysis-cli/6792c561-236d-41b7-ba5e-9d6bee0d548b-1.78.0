  {
    "id" : "terraform.aws.security.missing-athena-workgroup-encryption.missing-athena-workgroup-encryption",
    "level" : "High",
    "category" : "Security",
    "subCategory" : "InsecureStorage",
    "title" : "Enforce Athena Workgroup Encryption",
    "description" : "Ensures that AWS Athena Workgroup is configured with encryption enabled to protect query results.",
    "explanation" : "## missing-athena-workgroup-encryption\nThe AWS Athena Workgroup is unencrypted. Encryption protects query results in your workgroup. To enable, add: `encryption_configuration { encryption_option = \"SSE_KMS\" kms_key_arn =  aws_kms_key.example.arn }` within `result_configuration { }` in your resource block,  where `encryption_option` is your chosen encryption method and `kms_key_arn`  is your KMS key ARN.",
    "enabled" : false,
    "timeToFix" : 10,
    "parameters" : [
    ],
    "languages" : [
      {
        "name" : "Terraform"
      }
    ]
  },
  {
    "id" : "terraform.aws.security.unrestricted-github-oidc-policy.unrestricted-github-oidc-policy",
    "level" : "High",
    "category" : "Security",
    "subCategory" : "Auth",
    "title" : "Avoid Unrestricted GitHub OIDC Policy",
    "description" : "Detects AWS IAM policies for GitHub OIDC that lack a condition restricting usage to specific GitHub repositories.",
    "explanation" : "## unrestricted-github-oidc-policy\n`$POLICY` is missing a `condition` block which scopes users of this policy to specific GitHub repositories. Without this, `$POLICY` is open to all users on GitHub. Add a `condition` block on the variable `token.actions.githubusercontent.com:sub` which scopes it to prevent this.",
    "enabled" : true,
    "timeToFix" : 10,
    "parameters" : [
    ],
    "languages" : [
      {
        "name" : "Terraform"
      }
    ]
  },
