      },
      {
        "name" : "CPP"
      }
    ]
  },
  {
    "id" : "c_free_rule-memalign",
    "level" : "High",
    "category" : "Security",
    "subCategory" : "InsecureModulesLibraries",
    "title" : "Avoid using memalign due to unsafe alignment argument",
    "description" : "Detects usage of the deprecated memalign function which may not validate its alignment argument correctly, causing potential free failures on non-Linux systems.",
    "explanation" : "## c_free_rule-memalign\nThe `memalign` function may not check that the alignment argument is correct. Calling\nfree (on non Linux-based systems) may fail and in certain circumstances this failure\nmay be exploitable. This function has been deprecated in favor of `posix_memalign`.\n\nFor more information please see: https://linux.die.net/man/3/memalign",
    "enabled" : false,
    "timeToFix" : 10,
    "parameters" : [
    ],
    "languages" : [
      {
        "name" : "C"
      },
      {
        "name" : "CPP"
      }
    ]
  },
  {
