  {
    "id" : "apex.lang.best-practice.ncino.accessmodifiers.globalaccessmodifiers.global-access-modifiers",
    "level" : "Warning",
    "category" : "BestPractice",
    "subCategory" : null,
    "title" : "Avoid Global Access Modifiers",
    "description" : "This rule discourages the use of global access modifiers on classes, methods, and variables, especially in managed packages.",
    "explanation" : "## global-access-modifiers\nGlobal classes, methods, and variables should be avoided (especially in managed packages) as they can never be deleted or changed in signature. Always check twice if something needs to be global.",
    "enabled" : false,
    "timeToFix" : 5,
    "parameters" : [
    ],
    "languages" : [
      {
        "name" : "Apex"
      }
    ]
  },
  {
    "id" : "apex.lang.best-practice.ncino.tests.useassertclass.use-assert-class",
    "level" : "Warning",
    "category" : "BestPractice",
    "subCategory" : null,
    "title" : "Use Assert Class Instead of System Assert Methods",
    "description" : "Enforce the use of the Assert class for assertions instead of the deprecated System class assert methods in Apex code.",
    "explanation" : "## use-assert-class\nAssert methods in the System class have been replaced with the Assert class: https://developer.salesforce.com/docs/atlas.en-us.apexref.meta/apexref/apex_class_System_Assert.htm",
    "enabled" : false,
    "timeToFix" : 5,
    "parameters" : [
    ],
    "languages" : [
      {
        "name" : "Apex"
      }
    ]
  },
  {
    "id" : "apex.lang.best-practice.ncino.urls.absoluteurls.absolute-urls",
    "level" : "High",
    "category" : "ErrorProne",
    "subCategory" : null,
    "title" : "Avoid Using Absolute URLs to Salesforce Pages",
    "description" : "This rule detects usage of absolute URLs when referencing Salesforce pages, which is error-prone across different Salesforce environments.",
    "explanation" : "## absolute-urls\nUsing absolute URLs to Salesforce Pages is bug prone. Different sandboxes and production environments will have different instance names (like \"na10\", \"na15\" etc.). Code using absolute URLs will only work when it runs in the corresponding salesforce instances. It will break as soon as it is deployed in another one. Thus only relative URLs, i.e. without the domain and subdomain names, should be used when pointing to a salesforce page.",
    "enabled" : false,
    "timeToFix" : 5,
    "parameters" : [
    ],
    "languages" : [
      {
        "name" : "Apex"
      }
    ]
  },
  {
    "id" : "apex.lang.performance.ncino.operationsinloops.avoidnativedmlinloops.avoid-native-dml-in-loops",
    "level" : "High",
    "category" : "Performance",
    "subCategory" : null,
    "title" : "Avoid Native DML Statements Inside Loops",
    "description" : "This rule enforces avoiding DML (Data Manipulation Language) statements inside loops to prevent hitting Salesforce's DML governor limits.",
    "explanation" : "## avoid-native-dml-in-loops\nAvoid DML statements inside loops to avoid hitting the DML governor limit. Instead, try to batch up the data into a list and invoke your DML once on that list of data outside the loop.",
    "enabled" : false,
    "timeToFix" : 10,
    "parameters" : [
    ],
    "languages" : [
      {
        "name" : "Apex"
      }
    ]
  },
  {
    "id" : "apex.lang.performance.ncino.operationsinloops.avoidoperationswithlimitsinloops.avoid-operations-with-limits-in-loops",
    "level" : "High",
    "category" : "Performance",
    "subCategory" : null,
    "title" : "Avoid Operations with Limits in Loops",
    "description" : "Detects usage of database operations, DML, SOQL, SOSL, approval methods, email sending, and async scheduling inside loops that can cause governor limit exceptions in Apex.",
    "explanation" : "## avoid-operations-with-limits-in-loops\nDatabase class methods, DML operations, SOQL queries, SOSL queries, Approval class methods, Email sending, async scheduling or queueing within loops can cause governor limit exceptions. Instead, try to batch up the data into a list and invoke the operation once on that list of data outside the loop.",
    "enabled" : false,
    "timeToFix" : 10,
    "parameters" : [
    ],
    "languages" : [
      {
        "name" : "Apex"
      }
    ]
  },
  {
    "id" : "apex.lang.performance.ncino.operationsinloops.avoidsoqlinloops.avoid-soql-in-loops",
    "level" : "High",
    "category" : "Performance",
    "subCategory" : null,
    "title" : "Avoid SOQL Queries in Loops",
    "description" : "Detects SOQL queries and other database or asynchronous operations inside loops that can cause governor limit exceptions in Apex code.",
    "explanation" : "## avoid-soql-in-loops\nDatabase class methods, DML operations, SOQL queries, SOSL queries, Approval class methods, Email sending, async scheduling or queueing within loops can cause governor limit exceptions. Instead, try to batch up the data into a list and invoke the operation once on that list of data outside the loop.",
    "enabled" : false,
    "timeToFix" : 10,
    "parameters" : [
    ],
    "languages" : [
      {
        "name" : "Apex"
      }
    ]
  },
  {
    "id" : "apex.lang.performance.ncino.operationsinloops.avoidsoslinloops.avoid-sosl-in-loops",
    "level" : "High",
    "category" : "Performance",
    "subCategory" : null,
    "title" : "Avoid SOSL Queries Inside Loops",
    "description" : "Detects and prevents SOSL queries inside loops which can cause Salesforce governor limit exceptions.",
    "explanation" : "## avoid-sosl-in-loops\nDatabase class methods, DML operations, SOQL queries, SOSL queries, Approval class methods, Email sending, async scheduling or queueing within loops can cause governor limit exceptions. Instead, try to batch up the data into a list and invoke the operation once on that list of data outside the loop.",
    "enabled" : false,
    "timeToFix" : 10,
    "parameters" : [
    ],
    "languages" : [
      {
        "name" : "Apex"
      }
    ]
