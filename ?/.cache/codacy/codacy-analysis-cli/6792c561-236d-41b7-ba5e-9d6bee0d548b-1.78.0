    "category" : "Security",
    "subCategory" : "Auth",
    "title" : "Avoid Wildcard Access in AssumeRole Policy",
    "description" : "Detects when AWS IAM roles grant wildcard access to sts:AssumeRole, allowing anyone with the AWS account ID and role name to assume the role.",
    "explanation" : "## wildcard-assume-role\nDetected wildcard access granted to sts:AssumeRole. This means anyone with your AWS account ID and the name of the role can assume the role. Instead, limit to a specific identity in your account, like this: `arn:aws:iam::<account_id>:root`.",
    "enabled" : true,
    "timeToFix" : 10,
    "parameters" : [
    ],
    "languages" : [
      {
        "name" : "Terraform"
      }
