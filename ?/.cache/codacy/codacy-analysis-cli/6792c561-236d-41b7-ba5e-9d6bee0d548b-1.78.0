  {
    "id" : "java.lang.security.audit.xss.jsp.use-escapexml.use-escapexml",
    "level" : "Error",
    "category" : "Security",
    "subCategory" : "XSS",
    "title" : "Enforce use of escapeXml in JSP Expression Language",
    "description" : "Detects Expression Language segments in JSP that do not escape output, preventing potential cross-site scripting (XSS) vulnerabilities.",
    "explanation" : "## use-escapexml\nDetected an Expression Language segment that does not escape output. This is dangerous because if any data in this expression can be controlled externally, it is a cross-site scripting vulnerability. Instead, use the 'escapeXml' function from the JSTL taglib. See https://www.tutorialspoint.com/jsp/jstl_function_escapexml.htm for more information.",
    "enabled" : false,
    "timeToFix" : 10,
    "parameters" : [
    ],
    "languages" : [
      {
        "name" : "Java"
      }
    ]
