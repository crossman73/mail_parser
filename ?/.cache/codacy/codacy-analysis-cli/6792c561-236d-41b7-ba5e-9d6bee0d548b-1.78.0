    "id" : "java.lang.security.audit.xss.jsp.use-jstl-escaping.use-jstl-escaping",
    "level" : "Error",
    "category" : "Security",
    "subCategory" : "XSS",
    "title" : "Enforce Use of JSTL Escaping in JSP Expression Language",
    "description" : "Detects JSP Expression Language segments in tags that do not escape output, which can lead to cross-site scripting (XSS) vulnerabilities.",
    "explanation" : "## use-jstl-escaping\nDetected an Expression Language segment in a tag that does not escape output. This is dangerous because if any data in this expression can be controlled externally, it is a cross-site scripting vulnerability. Instead, use the 'out' tag from the JSTL taglib to escape this expression. See https://www.tutorialspoint.com/jsp/jstl_core_out_tag.htm for more information.",
    "enabled" : false,
    "timeToFix" : 10,
    "parameters" : [
    ],
    "languages" : [
      {
        "name" : "Java"
      }
    ]
  },
