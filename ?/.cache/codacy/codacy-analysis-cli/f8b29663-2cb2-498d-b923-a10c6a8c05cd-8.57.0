    "title" : "Enforce Jira Ticket Mentions in TODO Comments",
    "description" : "This rule checks TODO comments in code to ensure they include references to Jira ticket IDs.",
    "explanation" : null,
    "enabled" : false,
    "timeToFix" : 3,
