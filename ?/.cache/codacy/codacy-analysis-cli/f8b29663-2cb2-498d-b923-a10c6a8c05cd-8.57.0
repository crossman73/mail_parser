    "id" : "id-blacklist",
    "level" : "Info",
    "category" : "BestPractice",
    "subCategory" : null,
    "title" : "Disallow Specified Identifiers",
    "description" : "This rule disallows the use of specified identifier names in the code to prevent usage of undesirable or problematic variable names.",
    "explanation" : "---\ntitle: id-blacklist\nrule_type: suggestion\n---\n\n\nThis rule was **deprecated** in ESLint v7.5.0 and replaced by the [id-denylist](id-denylist) rule.",
    "enabled" : false,
    "timeToFix" : 5,
