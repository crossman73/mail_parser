    "title" : "Enforce sorted ES6 import declarations",
    "description" : "This rule enforces that import declarations within ES6 modules are sorted alphabetically.",
    "explanation" : null,
    "enabled" : false,
    "timeToFix" : 3,
    "parameters" : [
      {
        "name" : "ignoreCase",
        "default" : "false",
        "description" : "ignoreCase"
      },
      {
        "name" : "ignoreMemberSort",
        "default" : "false",
