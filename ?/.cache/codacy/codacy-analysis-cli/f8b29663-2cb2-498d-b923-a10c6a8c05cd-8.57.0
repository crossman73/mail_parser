        "name" : "allowBlockEnd",
        "default" : "false",
        "description" : "allowBlockEnd"
      },
      {
        "name" : "allowBlockStart",
        "default" : "false",
        "description" : "allowBlockStart"
      },
      {
        "name" : "beforeBlockComment",
        "default" : "true",
