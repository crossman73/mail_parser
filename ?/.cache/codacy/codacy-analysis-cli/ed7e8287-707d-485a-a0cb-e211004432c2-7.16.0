    "languages" : [
      {
        "name" : "Java"
      }
    ]
  },
  {
    "id" : "category_java_codestyle_MethodArgumentCouldBeFinal",
    "level" : "Info",
    "category" : "CodeStyle",
    "subCategory" : null,
    "title" : "Enforce Method Argument Could Be Final",
    "description" : "Detects method and constructor parameters that are never reassigned and can be declared final.",
    "explanation" : "Since: PMD 2.2\n\nReports method and constructor parameters that can be made final because they are never reassigned within the body of the method.\n\n            This rule ignores unused parameters so as not to overlap with the rule {% rule java/bestpractices/UnusedFormalParameter %}.\n            It will also ignore the parameters of abstract methods.\n\nExample(s):\n```\nclass Foo {\n    // reported, parameter can be declared final\n    public String foo1(String param) {\n        return param;\n    }\n    // not reported, parameter is declared final\n    public String foo2(final String param) {\n        return param.trim();\n    }\n    // not reported because param is unused\n    public String unusedParam(String param) {\n        return \"abc\";\n    }\n}\n```",
    "enabled" : false,
    "timeToFix" : 3,
    "parameters" : [
    ],
    "languages" : [
      {
        "name" : "Java"
      }
    ]
  },
  {
    "id" : "category_java_codestyle_MethodNamingConventions",
    "level" : "Info",
    "category" : "CodeStyle",
    "subCategory" : null,
    "title" : "Enforce Method Naming Conventions",
    "description" : "This rule enforces configurable naming conventions for method declarations in Java code to ensure they match specified regular expressions.",
    "explanation" : "Since: PMD 1.2\n\nConfigurable naming conventions for method declarations. This rule reports\n            method declarations which do not match the regex that applies to their\n            specific kind (e.g. JUnit test or native method). Each regex can be configured on the PMD configuration file.\nCheck the [PMD documentation](https://pmd.github.io/pmd-7.16.0/pmd_rules_java_codestyle.html#methodnamingconventions) for more information.\n\n            By default, this rule uses the standard Java naming convention (Camel case).\n\nExample(s):\n```\npublic class Foo {\n    public void fooStuff() {\n    }\n}\n```",
    "enabled" : true,
    "timeToFix" : 3,
    "parameters" : [
      {
        "name" : "junit3TestPattern",
        "default" : "test[A-Z0-9][a-zA-Z0-9]*",
        "description" : "junit3TestPattern: Regex which applies to JUnit 3 test method names"
      },
      {
        "name" : "junit4TestPattern",
        "default" : "[a-z][a-zA-Z0-9]*",
        "description" : "junit4TestPattern: Regex which applies to JUnit 4 test method names"
      },
      {
        "name" : "junit5TestPattern",
        "default" : "[a-z][a-zA-Z0-9]*",
        "description" : "junit5TestPattern: Regex which applies to JUnit 5 test method names"
      },
      {
        "name" : "methodPattern",
        "default" : "[a-z][a-zA-Z0-9]*",
        "description" : "methodPattern: Regex which applies to instance method names"
      },
      {
        "name" : "nativePattern",
        "default" : "[a-z][a-zA-Z0-9]*",
        "description" : "nativePattern: Regex which applies to native method names"
      },
      {
        "name" : "staticPattern",
        "default" : "[a-z][a-zA-Z0-9]*",
        "description" : "staticPattern: Regex which applies to static method names"
      }
    ],
    "languages" : [
      {
        "name" : "Java"
      }
    ]
  },
  {
    "id" : "category_java_codestyle_NoPackage",
    "level" : "Info",
    "category" : "CodeStyle",
    "subCategory" : null,
    "title" : "Enforce Package Declaration",
    "description" : "Ensures that all classes, interfaces, enums, and annotations belong to a named package and are not declared in the default package.",
    "explanation" : "Since: PMD 3.3\n\nDetects when a class, interface, enum or annotation does not have a package definition.\n\nExample(s):\n```\n// no package declaration\npublic class ClassInDefaultPackage {\n}\n```",
    "enabled" : true,
    "timeToFix" : 3,
