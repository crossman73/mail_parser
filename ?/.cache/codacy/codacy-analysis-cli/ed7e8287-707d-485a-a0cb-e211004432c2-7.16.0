        "name" : "Apex"
      }
    ]
  },
  {
    "id" : "category_ecmascript_bestpractices_AvoidWithStatement",
    "level" : "Warning",
    "category" : "BestPractice",
    "subCategory" : null,
    "title" : "Avoid With Statement",
    "description" : "This rule disallows the use of the 'with' statement in JavaScript code.",
    "explanation" : "Since: PMD 5.0.1\n\nAvoid using with - it's bad news\n\nExample(s):\n```\nwith (object) {\n    property = 3; // Might be on object, might be on window: who knows.\n}\n```",
    "enabled" : true,
    "timeToFix" : 5,
    "parameters" : [
