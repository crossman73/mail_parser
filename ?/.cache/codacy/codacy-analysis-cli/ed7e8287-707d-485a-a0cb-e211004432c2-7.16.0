    "level" : "Info",
    "category" : "Documentation",
    "subCategory" : null,
    "title" : "Enforce Comment Requirement",
    "description" : "This rule enforces that certain language elements must have Javadoc (formal) comments.",
    "explanation" : "Since: PMD 5.1\n\nDenotes whether javadoc (formal) comments are required (or unwanted) for specific language elements.\n\nExample(s):\n```\n/**\n*\n*\n* @author Jon Doe\n*/\n```",
    "enabled" : false,
    "timeToFix" : 5,
    "parameters" : [
