    "id" : "rulesets-design.xml-EmptyCatchBlock",
    "level" : "High",
    "category" : "ErrorProne",
    "subCategory" : null,
    "title" : "Avoid Empty Catch Blocks",
    "description" : "Detects empty catch blocks that silently swallow exceptions without handling them.",
    "explanation" : "Usually empty try-catch is a bad idea because you are silently swallowing an error condition\nand then continuing execution. Occasionally this may be the right thing to do, but often\nit's a sign that a developer saw an exception, didn't know what to do about it,\nand so used an empty catch to silence the problem.\n\nExample to avoid:\n\n    class Foo {\n        public function bar()\n            {\n                try {\n                    // ...\n                } catch (Exception $e) {} // empty catch block\n            }\n    }\n\n[Source](http://phpmd.org/rules/design.html#emptycatchblock)\n      ",
    "enabled" : true,
    "timeToFix" : 5,
    "parameters" : [
    ],
    "languages" : [
    ]
