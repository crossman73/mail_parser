  {
    "id" : "rulesets-cleancode.xml-ElseExpression",
    "level" : "Info",
    "category" : "CodeStyle",
    "subCategory" : null,
    "title" : "Avoid Else Expressions",
    "description" : "This rule enforces the use of return statements instead of else expressions to simplify control flow.",
    "explanation" : "\nInstead of using an else block, you can use an early return statement:\n\n    class Foo\n    {\n        public function bar($flag)\n        {\n            if ($flag) {\n                // one branch\n            } else {\n                // another branch\n            }\n        }\n    }\n\nRewrite without the else:\n\n    class Foo\n    {\n        public function bar($flag)\n        {\n            if ($flag) {\n                // one branch\n                return;\n            }\n\n            // another branch\n        }\n    }\n      ",
    "enabled" : true,
    "timeToFix" : 3,
    "parameters" : [
    ],
    "languages" : [
    ]
  },
  {
