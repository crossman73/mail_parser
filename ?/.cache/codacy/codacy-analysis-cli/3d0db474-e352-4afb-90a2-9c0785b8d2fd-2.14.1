    "id" : "rulesets-codesize.xml-CyclomaticComplexity",
    "level" : "Warning",
    "category" : "Complexity",
    "subCategory" : null,
    "title" : "Limit Cyclomatic Complexity",
    "description" : "This rule reports methods with high cyclomatic complexity, indicating too many decision points within a single method.",
    "explanation" : "\nCyclomatic complexity is determined by the number of decision points in a method plus one for the method entry.\nThe following keywords create new decision points: 'if', 'while', 'for', and 'case labels'. For example, this\ncode has a cyclomatic complexity level of 2:\n\n    function foo()\n    {\n        $t=date(\"H\");\n        if ($t<\"20\")\n        {\n            echo \"Have a good day!\";\n        }\n    }\n\n1-4 indicates low complexity, 5-7 medium complexity, 8-10 high complexity and 11+ indicates very high complexity.\n\n[Source](http://phpmd.org/rules/codesize.html#cyclomaticcomplexity)\n      ",
    "enabled" : true,
    "timeToFix" : 15,
    "parameters" : [
      {
        "name" : "reportLevel",
        "default" : "10",
        "description" : "The Cyclomatic Complexity reporting threshold"
      },
      {
        "name" : "showClassesComplexity",
        "default" : "true",
        "description" : "Indicate if class average violation should be included"
      },
      {
        "name" : "showMethodsComplexity",
        "default" : "true",
        "description" : "Indicate if method average violation should be included"
      }
    ],
    "languages" : [
    ]
  },
