[
  {
    "id" : "arrow_spacing",
    "level" : "Info",
    "category" : "CodeStyle",
    "subCategory" : null,
    "title" : "Enforce Proper Spacing Around Function Arrow",
    "description" : "Ensures that function arrow operators (-> and =>) have proper spacing before and after them.",
    "explanation" : "<p>This rule checks to see that there is spacing before and after\nthe arrow operator that declares a function. This rule is disabled\nby default.</p> <p>Note that if arrow_spacing is enabled, and you\npass an empty function as a parameter, arrow_spacing will accept\neither a space or no space in-between the arrow operator and the\nparenthesis</p>\n<pre><code># Both of this will not trigger an error,\n# even with arrow_spacing enabled.\nx(-> 3)\nx( -> 3)\n\n# However, this will trigger an error\nx((a,b)-> 3)\n</code>\n</pre>",
    "enabled" : false,
    "timeToFix" : 2,
    "parameters" : [
      {
        "name" : "empty_object_spaces",
        "default" : "0",
        "description" : "Number of spaces in empty objects"
      },
      {
        "name" : "spaces",
        "default" : "0",
        "description" : "Number of spaces"
      }
    ],
    "languages" : [
    ]
  },
  {
    "id" : "braces_spacing",
    "level" : "Info",
    "category" : "CodeStyle",
    "subCategory" : null,
    "title" : "Enforce Proper Spacing Inside Curly Braces",
    "description" : "Ensures that curly braces have the correct amount of spacing inside them according to specified spacing rules.",
    "explanation" : "This rule checks to see that there is the proper spacing inside\ncurly braces. The spacing amount is specified by \"spaces\".\nThe spacing amount for empty objects is specified by\n\"empty_object_spaces\".\nThe spacing amount for objects containing a single item is\nspecified by \"mono_object_spaces\".\n<pre><code>\n# Spaces is 0\n{a: b}     # Good\n{a: b }    # Bad\n{ a: b}    # Bad\n{ a: b }   # Bad\n# Spaces is 1\n{a: b}     # Bad\n{a: b }    # Bad\n{ a: b}    # Bad\n{ a: b }   # Good\n{ a: b  }  # Bad\n{  a: b }  # Bad\n{  a: b  } # Bad\n# Empty Object Spaces is 0\n{}         # Good\n{ }        # Bad\n# Empty Object Spaces is 1\n{}         # Bad\n{ }        # Good\n# Mono Object Spaces is 0\n{a}        # Good\n{ a }      # Bad\n# Mono Object Spaces is 1\n{a}        # Bad\n{ a }      # Good\n</code></pre>\nThis rule is disabled by default.",
    "enabled" : false,
    "timeToFix" : 3,
    "parameters" : [
    ],
    "languages" : [
    ]
  },
  {
    "id" : "bracket_spacing",
    "level" : "Info",
    "category" : "CodeStyle",
    "subCategory" : null,
    "title" : "Enforce Proper Spacing Inside Square Brackets",
    "description" : "This rule enforces the correct amount of spacing inside square brackets according to configured spacing rules for arrays, including empty arrays and single-item arrays.",
    "explanation" : "This rule checks to see that there is the proper spacing inside\nsquare brackets. The spacing amount is specified by \"spaces\".\nThe spacing amount for empty arrays is specified by\n\"empty_array_spaces\".\nThe spacing amount for arrays containing a single item is\nspecified by \"mono_array_spaces\".\nSpecified characters will be ignored if listed in \"exceptions\".\n<pre><code>\n# Spaces is 0\n[a, b]     # Good\n[a, b ]    # Bad\n[ a, b]    # Bad\n[ a, b ]   # Bad\n# Except brackets\n[ [a, b] ] # Good\n[[ a, b ]] # Bad\n# Spaces is 1\n[a, b]     # Bad\n[a, b ]    # Bad\n[ a, b]    # Bad\n[ a, b ]   # Good\n[ a, b  ]  # Bad\n[  a, b ]  # Bad\n[  a, b  ] # Bad\n# Except braces\n[{ a: b }] # Good\n[ {a: b} ] # Bad\n# Empty Array Spaces is 0\n[]         # Good\n[ ]        # Bad\n# Empty Array Spaces is 1\n[]         # Bad\n[ ]        # Good\n# Mono Array Spaces is 0\n[a]        # Good\n[ a ]      # Bad\n# Mono Array Spaces is 1\n[a]        # Bad\n[ a ]      # Good\n</code></pre>\nThis rule is disabled by default.",
    "enabled" : false,
    "timeToFix" : 3,
    "parameters" : [
    ],
    "languages" : [
    ]
  },
  {
    "id" : "camel_case_classes",
    "level" : "Info",
    "category" : "CodeStyle",
    "subCategory" : null,
    "title" : "Enforce Camel Case for Classes",
    "description" : "This rule enforces that all class names use UpperCamelCase naming convention.",
    "explanation" : "This rule mandates that all class names are UpperCamelCased.\nCamel casing class names is a generally accepted way of\ndistinguishing constructor functions - which require the 'new'\nprefix to behave properly - from plain old functions.\n<pre>\n<code># Good!\nclass BoaConstrictor\n\n# Bad!\nclass boaConstrictor\n</code>\n</pre>\nThis rule is enabled by default.",
    "enabled" : false,
    "timeToFix" : 2,
    "parameters" : [
    ],
    "languages" : [
    ]
  },
