    "languages" : [
    ]
  },
  {
    "id" : "no_backticks",
    "level" : "Warning",
    "category" : "BestPractice",
    "subCategory" : null,
    "title" : "Avoid Using Backticks in CoffeeScript",
    "description" : "This rule forbids the use of backticks in CoffeeScript code.",
    "explanation" : "Backticks allow snippets of JavaScript to be embedded in\nCoffeeScript. While some folks consider backticks useful in a few\nniche circumstances, they should be avoided because so none of\nJavaScript's \"bad parts\", like <tt>with</tt> and <tt>eval</tt>,\nsneak into CoffeeScript.\nThis rule is enabled by default.",
    "enabled" : true,
    "timeToFix" : 5,
    "parameters" : [
    ],
    "languages" : [
    ]
  },
  {
    "id" : "no_debugger",
    "level" : "Warning",
    "category" : "BestPractice",
    "subCategory" : null,
    "title" : "Avoid Debugger Statements",
    "description" : "This rule detects the presence of debugger statements and optionally console calls in the code.",
