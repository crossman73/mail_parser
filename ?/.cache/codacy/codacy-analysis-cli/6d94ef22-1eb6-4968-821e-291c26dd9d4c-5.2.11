  {
    "id" : "missing_fat_arrows",
    "level" : "High",
    "category" : "ErrorProne",
    "subCategory" : null,
    "title" : "Enforce Using Fat Arrows When Using 'this' in Functions",
    "description" : "Detects usage of 'this' inside functions not defined with fat arrow syntax, which can lead to incorrect 'this' binding.",
    "explanation" : "Warns when you use `this` inside a function that wasn't defined\nwith a fat arrow. This rule does not apply to methods defined in a\nclass, since they have `this` bound to the class instance (or the\nclass itself, for class methods). The option `is_strict` is\navailable for checking bindings of class methods.\n\nIt is impossible to statically determine whether a function using\n`this` will be bound with the correct `this` value due to language\nfeatures like `Function.prototype.call` and\n`Function.prototype.bind`, so this rule may produce false positives.",
    "enabled" : false,
    "timeToFix" : 10,
    "parameters" : [
      {
        "name" : "is_strict",
        "default" : "false",
        "description" : "Strict"
      }
    ],
    "languages" : [
    ]
  },
  {
    "id" : "missing_parseint_radix",
    "level" : "High",
    "category" : "ErrorProne",
    "subCategory" : null,
    "title" : "Enforce specifying radix in parseInt",
    "description" : "This rule ensures that parseInt is called with a radix argument to avoid unpredictable behavior.",
    "explanation" : "This rule warns about using parseInt without a radix. From the MDN\ndevelopers reference: <q>Always specify this parameter to eliminate\nreader confusion and to guarantee predictable behavior.</q>\n<pre>\n  <code># You would expect this to result in 8, but\n  # it might result in 0 (parsed as octal).\n  parseInt '08'\n\n  # To be safe, specify the radix argument:\n  parseInt '08', 10\n  </code>\n</pre>",
    "enabled" : false,
    "timeToFix" : 3,
    "parameters" : [
    ],
    "languages" : [
    ]
  },
  {
    "id" : "newlines_after_classes",
    "level" : "Info",
    "category" : "CodeStyle",
    "subCategory" : null,
    "title" : "Enforce Newlines After Classes",
    "description" : "This rule enforces the number of blank lines after class definitions to maintain consistent code formatting.",
    "explanation" : "<p>Checks the number of blank lines between classes and other code.</p>\n\nOptions:\n- <pre><code>value</code></pre> - The number of required blank lines\nafter class definitions. Defaults to 3.",
