  {
    "id" : "colon_assignment_spacing",
    "level" : "Info",
    "category" : "CodeStyle",
    "subCategory" : null,
    "title" : "Enforce Colon Assignment Spacing",
    "description" : "This rule enforces proper spacing before and after the colon in colon assignments within classes and objects.",
    "explanation" : "<p>This rule checks to see that there is spacing before and\nafter the colon in a colon assignment (i.e., classes, objects).\nThe spacing amount is specified by\nspacing.left and spacing.right, respectively.\nA zero value means no spacing required.\n</p>\n<pre><code>\n#\n# If spacing.left and spacing.right is 1\n#\n\n# Doesn't throw an error\nobject = {spacing : true}\nclass Dog\n  canBark : true\n\n# Throws an error\nobject = {spacing: true}\nclass Cat\n  canBark: false\n</code></pre>",
    "enabled" : false,
    "timeToFix" : 3,
    "parameters" : [
    ],
    "languages" : [
    ]
  },
  {
