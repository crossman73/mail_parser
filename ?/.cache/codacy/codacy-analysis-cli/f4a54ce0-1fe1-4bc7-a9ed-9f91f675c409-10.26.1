  {
    "id" : "AnnotationLocation",
    "level" : "Info",
    "category" : "CodeStyle",
    "subCategory" : null,
    "title" : "Enforce Annotation Location",
    "description" : "This rule enforces that annotations are placed immediately after the documentation block and before the target element, on a separate line, and with the same indentation level as the annotated element if not on the same line.",
    "explanation" : "<div>\n\nChecks location of annotation on language elements. By default, Check\nenforce to locate annotations immediately after documentation block and\nbefore target element, annotation should be located on separate line\nfrom target element. This check also verifies that the annotations are\non the same indenting level as the annotated element if they are not on\nthe same line.\n\n</div>\n\nAttention: Elements that cannot have JavaDoc comments like local\nvariables are not in the scope of this check even though a token type\nlike `VARIABLE_DEF` would match them.\n\nAttention: Annotations among modifiers are ignored (looks like\nfalse-negative) as there might be a problem with annotations for return\ntypes:\n\n    public @Nullable Long getStartTimeOrNull() { ... }\n\nSuch annotations are better to keep close to type. Due to limitations,\nCheckstyle can not examine the target of an annotation.\n\nExample:\n\n    @Override\n    @Nullable\n    public String getNameIfPresent() { ... }",
    "enabled" : false,
    "timeToFix" : 2,
    "parameters" : [
      {
        "name" : "allowSamelineMultipleAnnotations",
        "default" : "false",
        "description" : "Allow annotation(s) to be located on the same line as target element."
      },
      {
        "name" : "allowSamelineParameterizedAnnotation",
        "default" : "false",
        "description" : "Allow one and only parameterized annotation to be located on the same line as target element."
      },
      {
        "name" : "allowSamelineSingleParameterlessAnnotation",
        "default" : "true",
        "description" : "Allow single parameterless annotation to be located on the same line as target element."
      },
      {
        "name" : "tokens",
        "default" : "CLASS_DEF, INTERFACE_DEF, PACKAGE_DEF, ENUM_CONSTANT_DEF, ENUM_DEF, METHOD_DEF, CTOR_DEF, VARIABLE_DEF, RECORD_DEF, COMPACT_CTOR_DEF",
        "description" : "tokens to check"
      }
    ],
    "languages" : [
    ]
  },
