[
  {
    "id" : "AbbreviationAsWordInName",
    "level" : "Info",
    "category" : "CodeStyle",
    "subCategory" : null,
    "title" : "Enforce Abbreviation Length in Identifier Names",
    "description" : "This rule validates and limits the length of consecutive capital letters (abbreviations) in identifier names to enforce consistent camel case naming style.",
    "explanation" : "<div>\n\nValidates abbreviations (consecutive capital letters) length in\nidentifier name, it also allows to enforce camel case naming. Please\nread more at [Google Style\nGuide](../../styleguides/google-java-style-20220203/javaguide.html#s5.3-camel-case)\nto get to know how to avoid long abbreviations in names.\n\n</div>\n\n'\\_' is considered as word separator in identifier name.\n\n`allowedAbbreviationLength` specifies how many consecutive capital\nletters are allowed in the identifier. A value of *3* indicates that up\nto 4 consecutive capital letters are allowed, one after the other,\nbefore a violation is printed. The identifier 'MyTEST' would be allowed,\nbut 'MyTESTS' would not be. A value of *0* indicates that only 1\nconsecutive capital letter is allowed. This is what should be used to\nenforce strict camel casing. The identifier 'MyTest' would be allowed,\nbut 'MyTEst' would not be.\n\n`ignoreFinal`, `ignoreStatic`, and `ignoreStaticFinal` control whether\nvariables with the respective modifiers are to be ignored. Note that a\nvariable that is both static and final will always be considered under\n`ignoreStaticFinal` only, regardless of the values of `ignoreFinal` and\n`ignoreStatic`. So for example if `ignoreStatic` is true but\n`ignoreStaticFinal` is false, then static final variables will not be\nignored.",
    "enabled" : false,
    "timeToFix" : 3,
    "parameters" : [
      {
        "name" : "allowedAbbreviationLength",
        "default" : "3",
        "description" : "Indicate the number of consecutive capital letters allowed in targeted identifiers (abbreviations in the classes, interfaces, variables and methods names, ... )."
      },
      {
        "name" : "allowedAbbreviations",
        "default" : "",
        "description" : "Specify abbreviations that must be skipped for checking."
      },
      {
        "name" : "ignoreFinal",
        "default" : "true",
        "description" : "Allow to skip variables with final modifier."
      },
      {
        "name" : "ignoreOverriddenMethods",
        "default" : "true",
        "description" : "Allow to ignore methods tagged with @Override annotation (that usually mean inherited name)."
      },
      {
        "name" : "ignoreStatic",
        "default" : "true",
        "description" : "Allow to skip variables with static modifier."
      },
      {
        "name" : "ignoreStaticFinal",
        "default" : "true",
        "description" : "Allow to skip variables with both static and final modifiers."
      },
      {
        "name" : "tokens",
        "default" : "CLASS_DEF, INTERFACE_DEF, ENUM_DEF, ANNOTATION_DEF, ANNOTATION_FIELD_DEF, PARAMETER_DEF, VARIABLE_DEF, METHOD_DEF, PATTERN_VARIABLE_DEF, RECORD_DEF, RECORD_COMPONENT_DEF",
        "description" : "tokens to check"
      }
    ],
    "languages" : [
    ]
  },
  {
    "id" : "AbstractClassName",
    "level" : "Info",
    "category" : "BestPractice",
    "subCategory" : null,
    "title" : "Enforce Abstract Class Naming Convention",
    "description" : "Ensures that abstract classes have names conforming to a pattern that indicates they are abstract, typically by prefixing the class name with 'Abstract'.",
    "explanation" : "<div>\n\nEnsures that the names of abstract classes conforming to some pattern\nand check that `abstract` modifier exists.\n\n</div>\n\nRationale: Abstract classes are convenience base class implementations\nof interfaces. For this reason, it should be made obvious that a given\nclass is abstract by prefacing the class name with 'Abstract'.",
    "enabled" : false,
    "timeToFix" : 5,
    "parameters" : [
      {
        "name" : "format",
        "default" : "^Abstract.+$",
        "description" : "Specify valid identifiers."
      },
      {
        "name" : "ignoreModifier",
        "default" : "false",
        "description" : "Control whether to ignore checking for the abstract modifier on classes that match the name."
      },
      {
        "name" : "ignoreName",
        "default" : "false",
        "description" : "Control whether to ignore checking the name. Realistically only useful if using the check to identify that match name and do not have the abstract modifier."
      }
    ],
    "languages" : [
    ]
