  {
    "id" : "S4663",
    "level" : "Info",
    "category" : "Comprehensibility",
    "subCategory" : null,
    "title" : "Avoid Empty Comments",
    "description" : "This rule detects empty comments that do not contain any meaningful text.",
    "explanation" : "## Why is this an issue?\n\nEmpty comments, as shown in the example, hurt readability and might indicate an oversight.\n\n    //\n    \n    /*\n    */\n    \n    ///\n    \n    /**\n    */\n\nSome meaningful text should be added to the comment, or the comment markers should be removed.",
    "enabled" : false,
    "timeToFix" : 2,
    "parameters" : [
    ],
    "languages" : [
    ]
