        "default" : "8",
        "description" : "The maximum number of parameters which a function should take."
      }
    ],
    "languages" : [
    ]
  },
  {
    "id" : "refactor_io_puts",
    "level" : "Info",
    "category" : "BestPractice",
    "subCategory" : null,
    "title" : "Prefer Logger Statements Over IO.puts",
    "description" : "This rule encourages using Logger module functions instead of IO.puts for outputting messages.",
    "explanation" : "Prefer using Logger statements over using `IO.puts/1`.\n\nThis is a situational check.\n\nAs such, it might be a great help for e.g. Phoenix projects, but\na clear mismatch for CLI projects.",
    "enabled" : false,
    "timeToFix" : 5,
    "parameters" : [
    ],
    "languages" : [
    ]
  },
  {
    "id" : "refactor_long_quote_blocks",
    "level" : "Warning",
    "category" : "Complexity",
    "subCategory" : null,
    "title" : "Refactor Long Quote Blocks",
    "description" : "Detects long quote blocks that contain too much logic inside macros.",
    "explanation" : "Long `quote` blocks are generally an indication that too much is done inside\nthem.\n\nLet's look at why this is problematic:\n\n    defmodule MetaCommand do\n      def __using__(opts \\\\ []) do\n        modes = opts[:modes]\n        command_name = opts[:command_name]\n\n        quote do\n          def run(filename) do\n            contents =\n              if File.exists?(filename) do\n                {:ok, file} = File.open(filename, unquote(modes))\n                {:ok, contents} = IO.read(file, :line)\n                File.close(file)\n                contents\n              else\n                \"\"\n              end\n\n            case contents do\n              \"\" ->\n                # ...\n              unquote(command_name) <> rest ->\n                # ...\n            end\n          end\n\n          # ...\n        end\n      end\n    end\n\nA cleaner solution would be to call \"regular\" functions outside the\n`quote` block to perform the actual work.\n\n    defmodule MyMetaCommand do\n      def __using__(opts \\\\ []) do\n        modes = opts[:modes]\n        command_name = opts[:command_name]\n\n        quote do\n          def run(filename) do\n            MyMetaCommand.run_on_file(filename, unquote(modes), unquote(command_name))\n          end\n\n          # ...\n        end\n      end\n\n      def run_on_file(filename, modes, command_name) do\n        contents =\n          # actual implementation\n      end\n    end\n\nThis way it is easier to reason about what is actually happening. And to debug\nit.",
    "enabled" : true,
    "timeToFix" : 10,
    "parameters" : [
      {
        "name" : "ignore_comments",
        "default" : "false",
        "description" : "Ignores comments when counting the lines of a `quote` block."
      },
      {
        "name" : "max_line_count",
        "default" : "150",
        "description" : "The maximum number of lines a quote block should be allowed to have."
      }
    ],
    "languages" : [
    ]
  },
  {
    "id" : "refactor_map_join",
    "level" : "Warning",
    "category" : "Performance",
    "subCategory" : null,
    "title" : "Refactor to Use Enum.map_join Instead of Enum.map Followed by Enum.join",
    "description" : "Detects and suggests refactoring code that uses Enum.map followed by Enum.join to use Enum.map_join for better performance.",
    "explanation" : "`Enum.map_join/3` is more efficient than `Enum.map/2 |> Enum.join/2`.\n\nThis should be refactored:\n\n    [\"a\", \"b\", \"c\"]\n    |> Enum.map(&String.upcase/1)\n    |> Enum.join(\", \")\n\nto look like this:\n\n    Enum.map_join([\"a\", \"b\", \"c\"], \", \", &String.upcase/1)\n\nThe reason for this is performance, because the two separate calls\nto `Enum.map/2` and `Enum.join/2` require two iterations whereas\n`Enum.map_join/3` performs the same work in one pass.",
    "enabled" : true,
    "timeToFix" : 5,
    "parameters" : [
    ],
    "languages" : [
    ]
  },
  {
    "id" : "refactor_map_map",
    "level" : "Warning",
    "category" : "Performance",
    "subCategory" : null,
    "title" : "Refactor Multiple Enum.map Calls into a Single Enum.map",
    "description" : "Detects and encourages refactoring of consecutive Enum.map/2 calls into a single Enum.map/2 call to improve performance.",
    "explanation" : "One `Enum.map/2` is more efficient than `Enum.map/2 |> Enum.map/2`.\n\nThis should be refactored:\n\n    [:a, :b, :c]\n    |> Enum.map(&inspect/1)\n    |> Enum.map(&String.upcase/1)\n\nto look like this:\n\n    Enum.map([:a, :b, :c], fn letter ->\n      letter\n      |> inspect()\n      |> String.upcase()\n    end)\n\nThe reason for this is performance, because the two separate calls\nto `Enum.map/2` require two iterations whereas doing the functions\nin the single `Enum.map/2` only requires one.",
    "enabled" : false,
    "timeToFix" : 5,
    "parameters" : [
    ],
    "languages" : [
    ]
  },
  {
    "id" : "refactor_match_in_condition",
    "level" : "Info",
    "category" : "BestPractice",
    "subCategory" : null,
    "title" : "Refactor Pattern Match in Condition",
    "description" : "Ensures pattern matching in if/unless conditions is used only for simple assignments, avoiding complex patterns mixed with conditions and blocks.",
    "explanation" : "Pattern matching should only ever be used for simple assignments\ninside `if` and `unless` clauses.\n\nWhile this fine:\n\n    # okay, simple wildcard assignment:\n\n    if contents = File.read!(\"foo.txt\") do\n      do_something(contents)\n    end\n\nthe following should be avoided, since it mixes a pattern match with a\ncondition and do/else blocks.\n\n    # considered too \"complex\":\n\n    if {:ok, contents} = File.read(\"foo.txt\") do\n      do_something(contents)\n    end\n\n    # also considered \"complex\":\n\n    if allowed? && ( contents = File.read!(\"foo.txt\") ) do\n      do_something(contents)\n    end\n\nIf you want to match for something and execute another block otherwise,\nconsider using a `case` statement:\n\n    case File.read(\"foo.txt\") do\n      {:ok, contents} ->\n        do_something()\n      _ ->\n        do_something_else()\n    end",
    "enabled" : true,
    "timeToFix" : 5,
    "parameters" : [
      {
        "name" : "allow_tagged_tuples",
        "default" : "false",
        "description" : "Allow tagged tuples in conditions, e.g. `if {:ok, contents} = File.read( \"foo.txt\") do`"
      }
    ],
    "languages" : [
    ]
  },
  {
    "id" : "refactor_module_dependencies",
    "level" : "Warning",
    "category" : "Complexity",
    "subCategory" : null,
    "title" : "Limit Module Dependencies",
    "description" : "This rule suggests limiting the number of module dependencies to avoid modules doing too much.",
    "explanation" : "This module might be doing too much. Consider limiting the number of\nmodule dependencies.\n\nAs always: This is just a suggestion. Check the configuration options for\ntweaking or disabling this check.",
    "enabled" : false,
    "timeToFix" : 15,
    "parameters" : [
      {
        "name" : "dependency_namespaces",
        "default" : "[]",
        "description" : "List of dependency namespaces to include in this check"
      },
      {
        "name" : "excluded_namespaces",
        "default" : "[]",
        "description" : "List of namespaces to exclude from this check"
      },
      {
        "name" : "excluded_paths",
        "default" : "[\"/test/\",\"^test/\"]",
        "description" : "List of paths or regex to exclude from this check"
      },
      {
        "name" : "max_deps",
        "default" : "10",
        "description" : "Maximum number of module dependencies."
      }
    ],
    "languages" : [
    ]
  },
  {
    "id" : "refactor_negated_conditions_in_unless",
    "level" : "Info",
    "category" : "Comprehensibility",
    "subCategory" : null,
    "title" : "Refactor Negated Conditions in Unless",
    "description" : "Ensures that 'unless' blocks do not contain negated conditions to improve code readability.",
    "explanation" : "Unless blocks should avoid having a negated condition.\n\nThe code in this example ...\n\n    unless !allowed? do\n      proceed_as_planned()\n    end\n\n... should be refactored to look like this:\n\n    if allowed? do\n      proceed_as_planned()\n    end\n\nThe reason for this is not a technical but a human one. It is pretty difficult\nto wrap your head around a block of code that is executed if a negated\ncondition is NOT met. See what I mean?",
    "enabled" : true,
    "timeToFix" : 3,
    "parameters" : [
    ],
