    "parameters" : [
      {
        "name" : "applyToClassNames",
        "default" : "*Spec,*Test,*Tests,*TestCase",
        "description" : "applyToClassNames"
      }
    ],
    "languages" : [
    ]
  },
  {
    "id" : "JUnitTearDownCallsSuper",
    "level" : "High",
    "category" : "ErrorProne",
    "subCategory" : null,
    "title" : "EnforceJUnitTearDownCallsSuper",
    "description" : "Ensures that if a JUnit tearDown() method is defined, it calls super.tearDown().",
    "explanation" : "Rule that checks that if the JUnit `tearDown` method is defined, that it\nincludes a call to `super.tearDown()`.\n\nThis rule ignored methods annotated with `@After` or `@AfterClass`.\n\nThis rule sets the default value of the *applyToClassNames* property to\nonly match class names ending in ‘Spec’, ‘Test’, ‘Tests’ or ‘TestCase’.",
    "enabled" : true,
    "timeToFix" : 5,
    "parameters" : [
      {
        "name" : "applyToClassNames",
        "default" : "*Spec,*Test,*Tests,*TestCase",
        "description" : "applyToClassNames"
      }
    ],
    "languages" : [
    ]
