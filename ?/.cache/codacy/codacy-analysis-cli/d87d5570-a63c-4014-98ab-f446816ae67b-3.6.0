  },
  {
    "id" : "CatchIllegalMonitorStateException",
    "level" : "High",
    "category" : "ErrorProne",
    "subCategory" : null,
    "title" : "Avoid Catching IllegalMonitorStateException",
    "description" : "This rule detects when code catches IllegalMonitorStateException, which usually indicates a design flaw involving wait or notify calls without holding the proper lock.",
    "explanation" : "*Since CodeNarc 0.11*\n\nDubious catching of IllegalMonitorStateException.\nIllegalMonitorStateException is generally only thrown in case of a\ndesign flaw in your code (calling wait or notify on an object you do not\nhold a lock on).",
    "enabled" : true,
    "timeToFix" : 10,
    "parameters" : [
    ],
    "languages" : [
    ]
  },
  {
    "id" : "CatchIndexOutOfBoundsException",
    "level" : "Warning",
    "category" : "BestPractice",
    "subCategory" : null,
    "title" : "Avoid Catching IndexOutOfBoundsException",
    "description" : "Detects catching of IndexOutOfBoundsException instead of validating index bounds before accessing elements.",
    "explanation" : "*Since CodeNarc 0.12*\n\nChecks for catching a `IndexOutOfBoundsException`. Catching\n`IndexOutOfBoundsException` should be avoided in the first place by\nchecking for a valid index before accessing an indexed element. Catching\nthe exception may mask underlying errors.",
    "enabled" : true,
    "timeToFix" : 10,
    "parameters" : [
