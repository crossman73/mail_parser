  },
  {
    "id" : "EmptyIfStatement",
    "level" : "Warning",
    "category" : "ErrorProne",
    "subCategory" : null,
    "title" : "Avoid Empty If Statements",
    "description" : "Detects empty if statements that have no executable code inside their block.",
    "explanation" : "Checks for empty *if* statements. Empty *if* statements are confusing\nand serve no purpose.\n\nHere is an example of code that produces a violation:\n\n        def myMethod() {\n            if (x==23) {\n                // empty\n            }\n        }",
    "enabled" : true,
    "timeToFix" : 5,
    "parameters" : [
    ],
    "languages" : [
    ]
  },
  {
    "id" : "EmptyInstanceInitializer",
    "level" : "Info",
    "category" : "CodeStyle",
    "subCategory" : null,
    "title" : "Avoid Empty Instance Initializers",
    "description" : "Detects empty instance initializers in classes which are unnecessary and can be safely removed.",
    "explanation" : "*Since CodeNarc 0.13*\n\nAn empty class instance initializer was found. It is safe to remove it.\nExample:\n\n        class MyClass {\n            { }     // empty instance initializer, not a closure\n        }",
    "enabled" : true,
    "timeToFix" : 2,
    "parameters" : [
    ],
    "languages" : [
    ]
  },
  {
    "id" : "EmptyMethod",
    "level" : "Warning",
    "category" : "BestPractice",
    "subCategory" : null,
    "title" : "Avoid Empty Methods",
    "description" : "Detects methods without implementation unless they override a parent method with @Override annotation.",
    "explanation" : "*Since CodeNarc 0.13*\n\nA method was found without an implementation. If the method is\noverriding or implementing a parent method, then mark it with the\n`@Override` annotation. This rule should not be used with Java 5 code\nbecause you cannot put `@Override` on a method implementing an\ninterface. Use with Java 6 and higher.\n\nExample of violations:\n\n        class MyClass {\n\n            // violation, empty method\n            public void method1() {}\n\n            // violation, empty method\n            def method2() {}\n\n            // OK because of @Override\n            @Override\n            public void method3() {}\n        }\n\n        abstract class MyBaseClass {\n            // OK, handled by EmptyMethodInAbstractClass Rule\n            public void method() {}\n        }",
    "enabled" : true,
    "timeToFix" : 5,
    "parameters" : [
    ],
    "languages" : [
    ]
  },
  {
    "id" : "EmptyMethodInAbstractClass",
    "level" : "Warning",
    "category" : "BestPractice",
    "subCategory" : null,
    "title" : "Enforce Abstract Methods Instead of Empty Methods in Abstract Classes",
    "description" : "Ensures that empty methods in abstract classes are declared as abstract methods rather than providing empty implementations.",
    "explanation" : "*Since CodeNarc 0.12*\n\nAn empty method in an abstract class should be abstract instead, as\ndeveloper may rely on this empty implementation rather than code the\nappropriate one.\n\n        abstract class MyClass {\n            def couldBeAbstract_1() {\n                return null  // Should be abstract method\n            }\n\n            void couldBeAbstract_2() {\n                // Should be abstract method\n            }\n        }",
    "enabled" : true,
    "timeToFix" : 5,
    "parameters" : [
    ],
    "languages" : [
    ]
  },
  {
    "id" : "EmptyStaticInitializer",
    "level" : "Info",
    "category" : "CodeStyle",
    "subCategory" : null,
    "title" : "Avoid Empty Static Initializers",
    "description" : "Detects empty static initializer blocks in classes which can be safely removed.",
    "explanation" : "*Since CodeNarc 0.13*\n\nAn empty static initializer was found. It is safe to remove it. Example:\n\n        class MyClass {\n            static { }\n        }",
    "enabled" : true,
    "timeToFix" : 2,
    "parameters" : [
    ],
    "languages" : [
