    "languages" : [
    ]
  },
  {
    "id" : "EmptyWhileStatement",
    "level" : "Info",
    "category" : "CodeStyle",
    "subCategory" : null,
    "title" : "Avoid Empty While Statements",
    "description" : "Detects empty while loops that have no statements inside the loop body.",
    "explanation" : "Checks for empty *while* statements. Empty *while* statements are\nconfusing and serve no purpose.\n\nHere is an example of code that produces a violation:\n\n        def myMethod() {\n            while (!stopped) {\n                // empty\n            }\n        }",
    "enabled" : true,
    "timeToFix" : 3,
    "parameters" : [
