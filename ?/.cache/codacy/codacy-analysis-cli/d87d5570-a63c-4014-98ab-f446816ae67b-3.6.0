  },
  {
    "id" : "SpaceAfterMethodDeclarationName",
    "level" : "Info",
    "category" : "CodeStyle",
    "subCategory" : null,
    "title" : "Avoid Space After Method Declaration Name",
    "description" : "Ensures that method declarations do not have unnecessary whitespace between the method name and the opening parenthesis of the parameter list.",
    "explanation" : "*Since CodeNarc 2.1*\n\nCheck whether method declarations do not contain unnecessary whitespace\nbetween method name and the opening parenthesis for parameter list.\n\nExamples of violations:\n\n        class ClassWithWhitespaceInConstructorDeclaration {\n            \n            ClassWithWhitespaceInConstructorDeclaration () { //violation\n            }\n            \n            void methodWithWhitespaceInDeclaration () { //violation\n            }\n        }",
    "enabled" : true,
    "timeToFix" : 3,
    "parameters" : [
