  {
    "id" : "ExplicitGarbageCollection",
    "level" : "Warning",
    "category" : "Performance",
    "subCategory" : null,
    "title" : "Avoid Explicit Garbage Collection Calls",
    "description" : "This rule discourages explicit calls to System.gc(), Runtime.getRuntime().gc(), and System.runFinalization() in code.",
    "explanation" : "*Since CodeNarc 0.12*\n\nCalls to `System.gc()`, `Runtime.getRuntime().gc()`, and\n`System.runFinalization()` are not advised. Code should have the same\nbehavior whether the garbage collection is disabled using the option\n`-Xdisableexplicitgc` or not. Moreover, “modern” JVMs do a very good job\nhandling garbage collections. If memory usage issues unrelated to memory\nleaks develop within an application, it should be dealt with JVM options\nrather than within the code itself.",
    "enabled" : true,
    "timeToFix" : 5,
    "parameters" : [
    ],
    "languages" : [
    ]
  },
  {
    "id" : "ExplicitHashMapInstantiation",
    "level" : "Info",
    "category" : "BestPractice",
    "subCategory" : null,
    "title" : "Avoid Explicit HashMap Instantiation",
    "description" : "Detects explicit instantiation of a HashMap using the no-argument constructor in Groovy code.",
    "explanation" : "*Since CodeNarc 0.11*\n\nThis rule checks for explicit calls to the no-argument constructor of\n`HashMap`. In Groovy, it is best to replace `new HashMap()` with `[:]`,\nwhich creates (mostly) the same object. `[:]` is technically a\nLinkedHashMap but it is very rare that someone absolutely needs an\ninstance of `HashMap` and not a subclass.",
    "enabled" : true,
    "timeToFix" : 3,
    "parameters" : [
    ],
    "languages" : [
    ]
  },
