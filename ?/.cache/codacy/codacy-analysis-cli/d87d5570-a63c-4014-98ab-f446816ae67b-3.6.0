  {
    "id" : "SystemExit",
    "level" : "Error",
    "category" : "Security",
    "subCategory" : "DoS",
    "title" : "Avoid System.exit() Calls",
    "description" : "Detects calls to System.exit() in Groovy web applications which should be avoided.",
    "explanation" : "*Since CodeNarc 0.14*\n\nWeb applications should never call System.exit(). A call to\nSystem.exit() is probably part of leftover debug code or code imported\nfrom a non-J2EE application.\n\n- \\[1\\] Standards Mapping - OWASP Top 10 2004 - (OWASP 2004) A9\n  Application Denial of Service\n\n- \\[2\\] Standards Mapping - Security Technical Implementation Guide\n  Version 3 - (STIG 3) APP6080 CAT II\n\n- \\[3\\] Standards Mapping - Common Weakness Enumeration - (CWE) CWE ID\n  382\n\n- \\[4\\] Standards Mapping - Payment Card Industry Data Security Standard\n  Version 1.1 - (PCI 1.1) Requirement 6.5.9",
    "enabled" : true,
    "timeToFix" : 5,
    "parameters" : [
    ],
    "languages" : [
    ]
  },
  {
    "id" : "SystemOutPrint",
    "level" : "Warning",
    "category" : "BestPractice",
    "subCategory" : null,
    "title" : "Avoid System.out Print Calls",
    "description" : "Detects usage of System.out.print(), System.out.println(), or System.out.printf() in code.",
    "explanation" : "Checks for calls to `System.out.print()`, `System.out.println()` or\n`System.out.printf()`. Consider using a standard logging facility\ninstead.",
    "enabled" : true,
    "timeToFix" : 5,
    "parameters" : [
