  },
  {
    "id" : "EmptyTryBlock",
    "level" : "Info",
    "category" : "BestPractice",
    "subCategory" : null,
    "title" : "Avoid Empty Try Blocks",
    "description" : "Detects and disallows empty try blocks as they are confusing and serve no purpose.",
    "explanation" : "Checks for empty *try* blocks. Empty *try* blocks are confusing and\nserve no purpose. This rule ignores all try-with-resources statements.\n\nHere is an example of code that produces a violation:\n\n        def myMethod() {\n            try {\n                // empty\n            } catch(MyException e) {\n                e.printStackTrace()\n            }\n        }",
    "enabled" : true,
    "timeToFix" : 5,
    "parameters" : [
