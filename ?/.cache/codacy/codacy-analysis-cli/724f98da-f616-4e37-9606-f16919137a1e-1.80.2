    "id" : "Bundler_GemVersion",
    "level" : "Info",
    "category" : "BestPractice",
    "subCategory" : null,
    "title" : "Enforce Specifying or Forbidding Gem Versions",
    "description" : "Enforces whether gem version specifications or commit references are required or forbidden in Gemfile entries.",
    "explanation" : "\nEnforce that Gem version specifications or a commit reference (branch,\nref, or tag) are either required or forbidden.\n\n# Examples\n\n```ruby\n# bad\ngem 'rubocop'\n\n# good\ngem 'rubocop', '~> 1.12'\n\n# good\ngem 'rubocop', '>= 1.10.0'\n\n# good\ngem 'rubocop', '>= 1.5.0', '< 1.10.0'\n\n# good\ngem 'rubocop', branch: 'feature-branch'\n\n# good\ngem 'rubocop', ref: '74b5bfbb2c4b6fd6cdbbc7254bd7084b36e0c85b'\n\n# good\ngem 'rubocop', tag: 'v1.17.0'# good\ngem 'rubocop'\n\n# bad\ngem 'rubocop', '~> 1.12'\n\n# bad\ngem 'rubocop', '>= 1.10.0'\n\n# bad\ngem 'rubocop', '>= 1.5.0', '< 1.10.0'\n\n# bad\ngem 'rubocop', branch: 'feature-branch'\n\n# bad\ngem 'rubocop', ref: '74b5bfbb2c4b6fd6cdbbc7254bd7084b36e0c85b'\n\n# bad\ngem 'rubocop', tag: 'v1.17.0'\n```\n\n[Source](http://www.rubydoc.info/gems/rubocop/RuboCop/Cop/Bundler/GemVersion)",
    "enabled" : false,
    "timeToFix" : 5,
    "parameters" : [
      {
        "name" : "AllowedGems",
        "default" : "[]",
        "description" : "AllowedGems"
      },
      {
        "name" : "EnforcedStyle",
        "default" : "required",
        "description" : "EnforcedStyle"
      },
      {
        "name" : "Include",
        "default" : "[\"**/*.gemfile\",\"**/Gemfile\",\"**/gems.rb\"]",
        "description" : "Include"
      },
      {
        "name" : "SupportedStyles",
        "default" : "[\"required\",\"forbidden\"]",
        "description" : "SupportedStyles"
      }
