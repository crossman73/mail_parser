      },
      {
        "name" : "FunctionDeclaration",
        "default" : "{\"parameters\":1,\"body\":1}",
        "description" : "FunctionDeclaration"
      },
      {
        "name" : "FunctionExpression",
        "default" : "{\"parameters\":1,\"body\":1}",
        "description" : "FunctionExpression"
      },
      {
        "name" : "ignoreComments",
        "default" : "false",
