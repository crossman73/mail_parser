  {
    "id" : "security_detect-disable-mustache-escape",
    "level" : "High",
    "category" : "Security",
    "subCategory" : "XSS",
    "title" : "Detect Disabling of Mustache Escape",
    "description" : "Detects usage of 'object.escapeMarkup = false' which disables HTML entity escaping in some template engines.",
    "explanation" : null,
