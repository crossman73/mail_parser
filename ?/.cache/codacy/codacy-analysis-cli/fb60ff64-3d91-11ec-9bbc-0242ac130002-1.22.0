  {
    "id" : "path-declarations-must-exist",
    "level" : "High",
    "category" : "ErrorProne",
    "subCategory" : null,
    "title" : "Enforce Non-Empty Path Parameter Declarations",
    "description" : "Ensures that path parameter declarations in API paths are not empty, i.e., paths like `/given/{}` are invalid.",
    "explanation" : "# path-declarations-must-exist\n\nPath parameter declarations cannot be empty, ex.`/given/{}` is invalid.\n\n**Recommended:** Yes",
    "enabled" : true,
