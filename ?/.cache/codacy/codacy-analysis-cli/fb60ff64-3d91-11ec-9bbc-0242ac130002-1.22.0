  {
    "id" : "asyncapi-payload",
    "level" : "High",
    "category" : "ErrorProne",
    "subCategory" : null,
    "title" : "Enforce Valid AsyncAPI Payload Schema",
    "description" : "Ensures that payloads are valid according to the AsyncAPI v2 Schema Object definition when schemaFormat is undefined.",
    "explanation" : "# asyncapi-payload\n\nWhen `schemaFormat` is undefined, the `payload` object should be valid against the AsyncAPI v2 Schema Object definition.\n\n**Recommended:** Yes",
    "enabled" : true,
    "timeToFix" : 10,
