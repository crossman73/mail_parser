    "languages" : [
    ]
  },
  {
    "id" : "asyncapi-unused-components-server",
    "level" : "Warning",
    "category" : "BestPractice",
    "subCategory" : null,
    "title" : "Detect Potentially Unused AsyncAPI Components Server",
    "description" : "Detects potentially unused reusable server components in AsyncAPI specifications.",
    "explanation" : "# asyncapi-unused-components-server\n\nPotential unused reusable `server` entry has been detected.\n\n<!-- theme: warning -->\n\n_Warning:_ This rule may identify false positives when linting a specification\nthat acts as a library (a container storing reusable objects, leveraged by other\nspecifications that reference those objects).\n\n**Recommended:** Yes",
    "enabled" : true,
