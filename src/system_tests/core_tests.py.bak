def test_api_endpoints() -> Dict[str, Any]:
    """API 엔드포인트 테스트"""

    try:
        from src.web.app import create_app

        app = create_app()
        client = app.test_client()

        # 주요 API 엔드포인트 테스트
        endpoints = [
            ('/api/files', 200),
            ('/api/system/disk-usage', 200),
        ]

        failed_endpoints = []
        for endpoint, expected_status in endpoints:
            response = client.get(endpoint)
            if response.status_code != expected_status:
                failed_endpoints.append(f'{endpoint} (응답: {response.status_code})')

        if failed_endpoints:
            return {
                'status': 'failed',
                'message': f'API 엔드포인트 오류: {", ".join(failed_endpoints)}'
            }

        return {
            'status': 'success',
            'message': f'{len(endpoints)}개 API 엔드포인트 정상'
        }
    except Exception as e:
        return {
            'status': 'error',
            'message': f'테스트 중 오류: {str(e)}'
        }


def test_system_settings() -> Dict[str, Any]:
    """시스템 설정 기능 테스트"""
    try:
        from src.database.email_db import db

        # 테스트 설정 저장
        test_key = 'test_setting_key_temp'
        test_value = 'test_value'

        success = db.set_setting(test_key, test_value, 'string', '테스트 설정', 'general')

        if not success:
            return {
                'status': 'failed',
                'message': '설정 저장 실패'
            }

        # 설정 조회
        value = db.get_setting(test_key)

        if value != test_value:
            return {
                'status': 'failed',
                'message': f'설정 조회 오류 (저장: {test_value}, 조회: {value})'
            }

        # 설정 삭제
        db.delete_setting(test_key)

        return {
            'status': 'success',
            'message': '시스템 설정 CRUD 정상 작동'
        }
    except Exception as e:
        return {
            'status': 'error',
            'message': f'테스트 중 오류: {str(e)}'
        }


def test_disk_space() -> Dict[str, Any]:
    """디스크 공간 확인"""
    try:
        import shutil

        # 현재 디렉토리의 디스크 사용량 확인
        usage = shutil.disk_usage('.')

        free_gb = usage.free / (1024**3)
        total_gb = usage.total / (1024**3)
        used_percent = (usage.used / usage.total) * 100

        if free_gb < 1:
            return {
                'status': 'failed',
                'message': f'디스크 여유 공간 부족: {free_gb:.2f}GB'
            }

        return {
            'status': 'success',
            'message': f'디스크 여유 공간: {free_gb:.2f}GB / {total_gb:.2f}GB (사용률: {used_percent:.1f}%)'
        }
    except Exception as e:
        return {
            'status': 'error',
            'message': f'테스트 중 오류: {str(e)}'
        }
