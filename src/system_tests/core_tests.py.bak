"""
핵심 시스템 테스트
"""
from pathlib import Path
from typing import Any, Dict


def test_web_application() -> Dict[str, Any]:
    """웹 애플리케이션 테스트"""
    try:
        from src.web.app import create_app

        app = create_app()

        if app is None:
            return {
                'status': 'failed',
                'message': 'Flask 앱 생성 실패'
            }

        # 테스트 클라이언트 생성
        client = app.test_client()

        # 기본 라우트 테스트
        response = client.get('/')
        if response.status_code != 200:
            return {
                'status': 'failed',
                'message': f'메인 페이지 응답 오류: {response.status_code}'
            }

        return {
            'status': 'success',
            'message': 'Flask 앱 정상 작동, 메인 페이지 접근 가능'
        }
    except Exception as e:
        return {
            'status': 'error',
            'message': f'테스트 중 오류 발생: {str(e)}'
        }


def test_health_check() -> Dict[str, Any]:
    """헬스체크 엔드포인트 테스트"""
    try:
        from src.web.app import create_app

        app = create_app()
        client = app.test_client()

        response = client.get('/health')

        if response.status_code != 200:
            return {
                'status': 'failed',
                'message': f'헬스체크 응답 오류: {response.status_code}'
            }

        data = response.get_json()
        if not data or data.get('status') != 'healthy':
            return {
                'status': 'failed',
                'message': '헬스체크 상태가 healthy가 아님'
            }

        return {
            'status': 'success',
            'message': '헬스체크 정상'
        }
    except Exception as e:
        return {
            'status': 'error',
            'message': f'테스트 중 오류: {str(e)}'
        }


def test_database_connection() -> Dict[str, Any]:
    """데이터베이스 연결 테스트"""
    try:
        from src.database.email_db import db

        conn = db.get_connection()

        if conn is None:
            return {
                'status': 'failed',
                'message': '데이터베이스 연결 실패'
            }

        # 간단한 쿼리 실행
        cursor = conn.cursor()
        cursor.execute("SELECT 1")
        result = cursor.fetchone()
        conn.close()

        if result and result[0] == 1:
            return {
                'status': 'success',
                'message': '데이터베이스 연결 정상'
            }
        else:
            return {
                'status': 'failed',
                'message': '쿼리 실행 결과 오류'
            }
    except Exception as e:
        return {
            'status': 'error',
            'message': f'테스트 중 오류: {str(e)}'
        }


def test_config_file() -> Dict[str, Any]:
    """설정 파일 검증"""
    try:
        import json

        config_path = Path('config.json')

        if not config_path.exists():
            return {
                'status': 'failed',
                'message': 'config.json 파일이 존재하지 않음'
            }

        with open(config_path, 'r', encoding='utf-8') as f:
            config = json.load(f)

        required_keys = ['app_name', 'version', 'paths']
        missing_keys = [key for key in required_keys if key not in config]

        if missing_keys:
            return {
                'status': 'failed',
                'message': f'필수 설정 키 누락: {", ".join(missing_keys)}'
            }

        return {
            'status': 'success',
            'message': f'설정 파일 정상 (앱: {config["app_name"]}, 버전: {config["version"]})'
        }
    except json.JSONDecodeError as e:
        return {
            'status': 'error',
            'message': f'JSON 파싱 오류: {str(e)}'
        }
    except Exception as e:
        return {
            'status': 'error',
            'message': f'테스트 중 오류: {str(e)}'
        }


def test_directory_structure() -> Dict[str, Any]:
    """디렉토리 구조 검증"""
    try:
        required_dirs = [
            'data/db',
            'data/cases',
            'uploads',
            'processed_emails',
            'static',
            'templates'
        ]

        missing_dirs = []
        for dir_path in required_dirs:
            if not Path(dir_path).exists():
                missing_dirs.append(dir_path)

        if missing_dirs:
            return {
                'status': 'failed',
                'message': f'필수 디렉토리 누락: {", ".join(missing_dirs)}'
            }

        return {
            'status': 'success',
            'message': f'{len(required_dirs)}개 필수 디렉토리 모두 존재'
        }
    except Exception as e:
        return {
            'status': 'error',
            'message': f'테스트 중 오류: {str(e)}'
        }


