# Example .env for workspace secrets used by MCP servers
# DO NOT COMMIT real secrets. Copy this to .vscode/.env and fill values locally.
# Example entries:
BRAVE_API_KEY=
GITHUB_TOKEN=
CODACY_ACCOUNT_TOKEN=

# Usage: put real keys here in .vscode/.env (gitignored) and use the helper script
# scripts/load_env_and_start_vscode.ps1 to start VS Code with these environment variables.
